{
  "name": "craftzbay-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @craftzbay/site dev",
    "build": "pnpm --filter @craftzbay/ui build && pnpm --filter @craftzbay/site build",
    "build:lib": "pnpm --filter @craftzbay/ui build",
    "build:site": "pnpm --filter @craftzbay/site build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @craftzbay/ui test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9"
  }
}
